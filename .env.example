# Vett — env vars used in production. Sync this file with code by running:
#   grep -rhoE 'process\.env\.[A-Z_][A-Z0-9_]*' --include="*.ts" --include="*.tsx" app/ lib/ components/ | sort -u
# Anything listed here is referenced by app code at runtime. NEXT_PUBLIC_*
# is exposed to the browser bundle; everything else is server-only.

# ─── SUPABASE ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server only — bypasses RLS

# ─── SITE ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vettrentals.com

# ─── EMAIL (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Vett <noreply@vettrentals.com>

# ─── CRON JOBS ────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Used by /api/cron/* and /api/sync/* — set the same value on the
# Vercel cron job's Authorization header.
CRON_SECRET=your-cron-secret

# ─── EMAIL UNSUBSCRIBE TOKENS ─────────────────────────────────
# Generate: openssl rand -hex 32 — signs unsubscribe links so they
# can't be forged. Different from CRON_SECRET.
UNSUBSCRIBE_SIGNING_KEY=your-unsubscribe-signing-key

# ─── ANALYTICS ────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── ERROR MONITORING ─────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# ─── PAYMENTS (Stripe — Phase 2, leave blank for now) ─────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_VERIFIED_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_VERIFIED_ANNUAL=price_xxxxxxxx

# ─── DATA SYNC API TOKENS ─────────────────────────────────────
# Free registration at each portal — used by lib/data-sync/*
NYC_OPEN_DATA_TOKEN=your-nyc-app-token              # data.cityofnewyork.us
CHICAGO_DATA_TOKEN=your-chicago-app-token           # data.cityofchicago.org
SF_DATA_TOKEN=your-sf-app-token                     # data.sfgov.org
HOUSTON_DATA_TOKEN=your-houston-app-token           # data.houstontx.gov
PHOENIX_DATA_TOKEN=your-phoenix-app-token           # phoenixopendata.com
SAN_ANTONIO_DATA_TOKEN=your-san-antonio-token       # data.sanantonio.gov
COURT_LISTENER_TOKEN=your-courtlistener-token       # courtlistener.com (free, v4 API)
HUD_API_KEY=your-hud-api-key                        # huduser.gov

# ─── DATA SYNC: SOCRATA DATASET IDS ───────────────────────────
# Each city's open-data portal exposes datasets by 4x4-style ID.
# Override the defaults in code by setting the var if a dataset
# is renamed or replaced. All optional — code falls back to the
# built-in ID when unset.
ALLEGHENY_DATASET=
AUSTIN_DATASET=
BOSTON_RESOURCE_ID=
CUYAHOGA_DATASET=
DALLAS_DATASET=
DC_ASSESSOR_DATASET=
DENVER_ASSESSOR_DATASET=
FRANKLIN_COUNTY_DATASET=
HARRIS_COUNTY_DATASET=
HOUSTON_DATASET=
KING_COUNTY_DATASET=
LA_COUNTY_DATASET=
LA_LAHD_DATASET=
LA_RSO_DATASET=
MARICOPA_DATASET=
MECKLENBURG_DATASET=
MIAMI_DADE_DATASET=
NASHVILLE_DATASET=
SEATTLE_DATASET=
TRAVIS_COUNTY_DATASET=
WAKE_COUNTY_DATASET=

# ─── DATA SYNC: ARCGIS SERVICES ───────────────────────────────
# Some cities switched from Socrata to ArcGIS Feature Services.
# Override with the FeatureServer URL if upstream changes.
ATLANTA_ARCGIS_SERVICE=
DC_ARCGIS_SERVICE=
DENVER_ARCGIS_SERVICE=
MIAMI_ARCGIS_SERVICE=

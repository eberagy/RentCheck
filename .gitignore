# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
# We use pnpm — block stray package-lock.json (yarn.lock similarly) from
# being regenerated by accidental npm/yarn install. Removed from VCS in
# b49bbd3 alongside the README pnpm-migration.
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code tooling artifacts
.claude/
.gstack/
